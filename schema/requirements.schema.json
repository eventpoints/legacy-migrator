{
  "$ref": "#/definitions/RequirementsDocument",
  "definitions": {
    "RequirementsDocument": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "0.1.0"
        },
        "repo": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "commit": {
              "type": "string"
            },
            "language": {
              "type": "string"
            },
            "analyzedAt": {
              "type": "string"
            }
          },
          "required": [
            "analyzedAt"
          ],
          "additionalProperties": false
        },
        "slices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "default": ""
              },
              "features": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string",
                      "default": ""
                    },
                    "entrypoints": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "default": []
                    },
                    "rules": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "name": {
                            "type": "string",
                            "minLength": 1
                          },
                          "given": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "default": []
                          },
                          "when": {
                            "type": "string",
                            "minLength": 1
                          },
                          "then": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "minItems": 1
                          },
                          "dataTouchpoints": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "table": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "columns": {
                                  "type": "array",
                                  "items": {
                                    "type": "string"
                                  },
                                  "default": []
                                },
                                "access": {
                                  "type": "string",
                                  "enum": [
                                    "read",
                                    "write",
                                    "read-write"
                                  ]
                                },
                                "note": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "table",
                                "access"
                              ],
                              "additionalProperties": false
                            },
                            "default": []
                          },
                          "sourceRefs": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "file": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "symbol": {
                                  "type": "string"
                                },
                                "startLine": {
                                  "type": "integer",
                                  "exclusiveMinimum": 0
                                },
                                "endLine": {
                                  "type": "integer",
                                  "exclusiveMinimum": 0
                                }
                              },
                              "required": [
                                "file",
                                "startLine",
                                "endLine"
                              ],
                              "additionalProperties": false
                            },
                            "minItems": 1
                          },
                          "confidence": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "extracted",
                              "reviewed",
                              "corrected",
                              "rejected"
                            ],
                            "default": "extracted"
                          },
                          "notes": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "name",
                          "when",
                          "then",
                          "sourceRefs",
                          "confidence"
                        ],
                        "additionalProperties": false
                      },
                      "default": []
                    },
                    "sourceRefs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "file": {
                            "type": "string",
                            "minLength": 1
                          },
                          "symbol": {
                            "type": "string"
                          },
                          "startLine": {
                            "type": "integer",
                            "exclusiveMinimum": 0
                          },
                          "endLine": {
                            "type": "integer",
                            "exclusiveMinimum": 0
                          }
                        },
                        "required": [
                          "file",
                          "startLine",
                          "endLine"
                        ],
                        "additionalProperties": false
                      },
                      "default": []
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "extracted",
                        "reviewed",
                        "corrected",
                        "rejected"
                      ],
                      "default": "extracted"
                    }
                  },
                  "required": [
                    "id",
                    "name"
                  ],
                  "additionalProperties": false
                },
                "default": []
              },
              "sourceRefs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "file": {
                      "type": "string",
                      "minLength": 1
                    },
                    "symbol": {
                      "type": "string"
                    },
                    "startLine": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    },
                    "endLine": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "file",
                    "startLine",
                    "endLine"
                  ],
                  "additionalProperties": false
                },
                "default": []
              },
              "status": {
                "type": "string",
                "enum": [
                  "extracted",
                  "reviewed",
                  "corrected",
                  "rejected"
                ],
                "default": "extracted"
              }
            },
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false
          },
          "default": []
        }
      },
      "required": [
        "schemaVersion",
        "repo"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
